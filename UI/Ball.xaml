<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NudgeWatch · 悬浮球" Width="58" Height="92"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Focusable="False" Cursor="Hand">
  <StackPanel HorizontalAlignment="Center">
    <Grid Width="58" Height="58">
      <Border x:Name="Surface" Width="48" Height="48" Margin="5" Background="#245343"
              BorderBrush="#55FFFFFF" BorderThickness="1.5" CornerRadius="24">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
          <!-- 顶部高光，增加质感 -->
          <Ellipse Margin="3,2,3,16" Fill="{DynamicResource BallGlossBrush}" IsHitTestVisible="False"/>
          <!-- 无未读时显示品牌徽标 -->
          <Viewbox x:Name="LogoMark" Width="26" Height="26" Visibility="Collapsed">
            <Canvas Width="24" Height="24">
              <Path Data="{StaticResource LogoN}" Stroke="#F7F2E6" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Canvas.Left="16.1" Canvas.Top="4" Width="4.4" Height="4.4" Fill="#F0A04B"/>
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="Badge" Foreground="White" FontSize="17" FontWeight="Bold" Typography.NumeralAlignment="Tabular"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Text="0"/>
        </Grid>
      </Border>
      <!-- 免打扰：保留品牌色，右下角叠加月牙徽章 -->
      <Border x:Name="QuietMark" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,2,2" Background="{DynamicResource QuietBrush}" BorderBrush="#F7F2E6" BorderThickness="1.5" Visibility="Collapsed">
        <Path Data="{StaticResource MoonGeometry}" Fill="#F7F2E6" Width="10" Height="10" Stretch="Uniform"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <!-- 失联：右上角感叹号 -->
      <Border x:Name="LostMark" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,2,2,0" Background="#FFF7F2E6" Visibility="Collapsed">
        <TextBlock Text="!" FontWeight="Black" FontSize="12" Foreground="#B22222" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Grid>

    <!-- 微信开关圆扣：一键打开或最小化微信窗口（最小化前自动回顶） -->
    <Button x:Name="WeChatToggle" Width="30" Height="30" Margin="0,-2,0,4" Focusable="False" Cursor="Hand"
            BorderBrush="{DynamicResource BorderBrush}"
            ToolTip="打开或收起微信窗口（最小化前自动回顶） · 也可中键点击悬浮球">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="PillBg" Width="28" Height="28" CornerRadius="14"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1.5" Opacity="0.26"/>
              </Border.Effect>
              <Grid>
                <Ellipse Margin="3,1.5,3,13" Fill="{DynamicResource BallGlossBrush}" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource SubCardBrush}"/>
              <Setter TargetName="PillBg" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="1.07" ScaleY="1.07"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PillBg" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
      <Grid Width="18" Height="18">
        <Path x:Name="WeChatBubble"
              Data="M 9 2.5 C 4.9 2.5 1.8 5.2 1.8 8.6 C 1.8 10.5 2.8 12.2 4.5 13.3 L 3.7 15.8 L 6.5 14.4 C 7.3 14.6 8.1 14.7 9 14.7 C 13.1 14.7 16.2 12 16.2 8.6 C 16.2 5.2 13.1 2.5 9 2.5 Z"
              Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
        <Path x:Name="WeChatMinIcon"
              Data="M 6.3 7.6 L 9 10.4 L 11.7 7.6"
              Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        <Path x:Name="WeChatOpenIcon"
              Data="M 6.3 10.0 L 9 7.2 L 11.7 10.0"
              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Visibility="Collapsed"/>
        <Ellipse x:Name="WeChatStateDot" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0.5,0"
                 Fill="{DynamicResource SuccessBrush}"/>
      </Grid>
    </Button>
  </StackPanel>
</Window>
