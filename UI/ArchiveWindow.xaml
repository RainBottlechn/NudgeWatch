<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信消息归档与导出" Width="740" Height="580" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource InkBrush}">
  <Grid>
    <Border Background="{DynamicResource CanvasOverlayBrush}" IsHitTestVisible="False"/>
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="{DynamicResource OilDialogBannerHeight}" Background="{DynamicResource OilBannerBrush}">
        <Border Background="{DynamicResource OilBannerScrimBrush}" Visibility="{DynamicResource OilBannerCaptionVisibility}"/>
        <Border Height="6" VerticalAlignment="Bottom" Background="{DynamicResource BannerFadeBrush}" Visibility="{DynamicResource BannerFadeVisibility}"/>
        <TextBlock Text="{DynamicResource OilBannerCaption}" Visibility="{DynamicResource OilBannerCaptionVisibility}"
                   Style="{StaticResource BannerCaption}" Margin="0,0,12,4"/>
      </Grid>
      <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                   Text="归档内容来自微信会话列表实时监测到的消息摘要。微信关闭到托盘期间不会产生归档。"/>
        <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,8" CornerRadius="10"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <WrapPanel>
              <ComboBox x:Name="Range" Width="120" ToolTip="时间范围" Margin="0,0,6,4"/>
              <DatePicker x:Name="From" Width="130" ToolTip="开始日期（含）" Margin="0,0,6,4"/>
              <DatePicker x:Name="Through" Width="130" ToolTip="结束日期（含）" Margin="0,0,6,4"/>
              <ComboBox x:Name="Importance" Width="148" ToolTip="消息等级或 @我" Margin="0,0,0,4"/>
            </WrapPanel>
            <TextBox x:Name="Keyword" Tag="按摘要、会话或分组筛选关键词…" ToolTip="按摘要、会话或分组筛选关键词" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <WrapPanel DockPanel.Dock="Right">
            <ComboBox x:Name="Format" Width="106" ToolTip="导出格式" Margin="0,0,6,0"/>
            <ComboBox x:Name="MarkdownLayout" Width="106" ToolTip="Markdown 排版" Margin="0,0,6,0"/>
            <Button x:Name="Copy" Content="复制到剪贴板" Margin="0,0,6,0" Padding="12,5"/>
            <Button x:Name="Export" Content="导出文件" Style="{StaticResource PrimaryButton}" Padding="14,5"/>
          </WrapPanel>
          <TextBlock x:Name="Matched" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <Button x:Name="SelectAll" Style="{StaticResource ChipButton}" Content="全选" Margin="0,0,4,0"/>
              <Button x:Name="Invert" Style="{StaticResource ChipButton}" Content="反选" Margin="0,0,4,0"/>
              <Button x:Name="SelectNone" Style="{StaticResource ChipButton}" Content="清空"/>
            </WrapPanel>
            <TextBox x:Name="ChatFilter" DockPanel.Dock="Top" Margin="0,0,0,5" Tag="筛选会话名称…" ToolTip="筛选会话名称"/>
            <TreeView x:Name="ArchiveChats"/>
          </DockPanel>
          <TextBox x:Name="Preview" Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Background="{DynamicResource SubCardBrush}" Foreground="{DynamicResource InkBrush}"
                   VerticalContentAlignment="Top" Padding="10,8" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" ToolTip="归档命中预览"/>
        </Grid>
      </DockPanel>
    </DockPanel>
  </Grid>
</Window>
